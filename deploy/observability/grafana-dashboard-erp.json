  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate by Service (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(erp_http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx Error Ratio (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum by (service) (rate(erp_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(erp_http_requests_total[5m])), 1e-6)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP P99 Request Latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(erp_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "{{service}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transactional Outbox Backlog (Unpublished Rows)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "max by (service) (erp_outbox_unpublished_rows)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Go Runtime Goroutines by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (service) (go_goroutines)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Go Runtime Heap Alloc (Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (service) (go_memstats_alloc_bytes)",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "refresh": "30s",
