# Local development only. docker-compose.yml falls back to throwaway defaults
# (postgres / app) when these are unset; never reuse them outside a laptop.
# Staging/production credentials come from External Secrets (deploy/k8s/base/external-secrets.yaml).
#
#   cp .env.example .env   # then replace every value below

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
ERP_APP_USER=erp_app
ERP_APP_PASSWORD=change-me-local-only
