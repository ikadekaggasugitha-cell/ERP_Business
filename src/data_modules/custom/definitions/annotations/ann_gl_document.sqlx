config {
  type: "view",
  schema: dataform.projectConfig.vars.target_dataset,
  tags: ["annotation", "gl", "cortex_v7"],
  description: "Unified GL document journal entries across SAP ECC, SAP S/4HANA, and NEW_ERP"
}

WITH tcurx_shift AS (
  ${currency.currencyDecimalShift(ref("stg_tcurx"))}
),

ecc_gl AS (
  SELECT
    'SAP_ECC' AS source_system,
    h.mandt,
    h.company_code,
    h.document_number,
    h.fiscal_year,
    CAST(l.line_item_number AS STRING) AS line_number,
    ${sap_helpers.safeSapDate("h.posting_date")} AS posting_date,
    ${sap_helpers.safeSapDate("h.document_date")} AS document_date,
    TIMESTAMP(${sap_helpers.safeSapDate("h.entry_date")}) AS entry_timestamp,
    h.document_type,
    h.document_status,
    h.reference_document_number,
    l.gl_account_number AS account_code,
    l.debit_credit_indicator,
    l.cost_center,
    l.profit_center,
    l.plant AS plant_code,
    
    -- Transaction currency amount with decimal shift & sign
    CASE
      WHEN l.debit_credit_indicator = 'H' THEN -1 * ${currency.amountWithDecimalShift("l.amount_doc_curr", "shift_tc")}
      ELSE ${currency.amountWithDecimalShift("l.amount_doc_curr", "shift_tc")}
    END AS amount_tc,
    TRIM(COALESCE(l.currency_doc, h.currency_key)) AS currency_tc,
    
    -- Functional currency amount (local currency 1 in ECC)
    CASE
      WHEN l.debit_credit_indicator = 'H' THEN -1 * ${currency.amountWithDecimalShift("l.amount_loc_curr", "shift_fc")}
      ELSE ${currency.amountWithDecimalShift("l.amount_loc_curr", "shift_fc")}
    END AS amount_fc,
    TRIM(h.currency_key) AS currency_fc,
    
    -- Presentation currency amount (local currency 2 in ECC if populated, else NULL to be calculated)
    CASE
      WHEN l.amount_loc_curr2 IS NOT NULL THEN
        CASE
          WHEN l.debit_credit_indicator = 'H' THEN -1 * ${currency.amountWithDecimalShift("l.amount_loc_curr2", "shift_pc")}
          ELSE ${currency.amountWithDecimalShift("l.amount_loc_curr2", "shift_pc")}
        END
      ELSE CAST(NULL AS NUMERIC)
    END AS amount_pc,
    CAST(NULL AS STRING) AS currency_pc,
    
    ${sap_helpers.latestRecordstamp(["h.recordstamp", "l.recordstamp"])} AS source_last_updated_at
  FROM ${ref("stg_bkpf")} h
  INNER JOIN ${ref("stg_bseg")} l
    ON h.mandt = l.mandt
    AND h.company_code = l.company_code
    AND h.document_number = l.document_number
    AND h.fiscal_year = l.fiscal_year
  LEFT JOIN tcurx_shift shift_tc
    ON TRIM(COALESCE(l.currency_doc, h.currency_key)) = shift_tc.currkey
  LEFT JOIN tcurx_shift shift_fc
    ON TRIM(h.currency_key) = shift_fc.currkey
  LEFT JOIN tcurx_shift shift_pc
    ON '${dataform.projectConfig.vars.holding_presentation_currency}' = shift_pc.currkey
),

s4_gl AS (
  SELECT
    'SAP_S4HANA' AS source_system,
    l.mandt,
    l.company_code,
    l.document_number,
    l.fiscal_year,
    -- DOCLN preserves line uniqueness in Universal Journal (avoids BUZEI = '000' collision)
    CAST(l.line_item_number AS STRING) AS line_number,
    ${sap_helpers.safeSapDate("COALESCE(l.posting_date, h.posting_date)")} AS posting_date,
    ${sap_helpers.safeSapDate("COALESCE(l.document_date, h.document_date)")} AS document_date,
    TIMESTAMP(${sap_helpers.safeSapDate("h.entry_date")}) AS entry_timestamp,
    h.document_type,
    h.document_status,
    h.reference_document_number,
    l.gl_account_number AS account_code,
    l.debit_credit_indicator,
    l.cost_center,
    l.profit_center,
    l.plant AS plant_code,
    
    -- ACDOCA triplet amounts with sign alignment
    CASE
      WHEN l.debit_credit_indicator = 'H' THEN -1 * ABS(CAST(l.amount_tc AS NUMERIC))
      ELSE ABS(CAST(l.amount_tc AS NUMERIC))
    END AS amount_tc,
    TRIM(l.currency_tc) AS currency_tc,
    
    CASE
      WHEN l.debit_credit_indicator = 'H' THEN -1 * ABS(CAST(l.amount_fc AS NUMERIC))
      ELSE ABS(CAST(l.amount_fc AS NUMERIC))
    END AS amount_fc,
    TRIM(l.currency_fc) AS currency_fc,
    
    CASE
      WHEN l.debit_credit_indicator = 'H' THEN -1 * ABS(CAST(l.amount_pc AS NUMERIC))
      ELSE ABS(CAST(l.amount_pc AS NUMERIC))
    END AS amount_pc,
    TRIM(l.currency_pc) AS currency_pc,
    
    ${sap_helpers.latestRecordstamp(["h.recordstamp", "l.recordstamp"])} AS source_last_updated_at
  FROM ${ref("stg_acdoca")} l
  LEFT JOIN ${ref("stg_bkpf")} h
    ON l.mandt = h.mandt
    AND l.company_code = h.company_code
    AND l.document_number = h.document_number
    AND l.fiscal_year = h.fiscal_year
),

new_erp_gl AS (
  SELECT
    'NEW_ERP' AS source_system,
    '000' AS mandt,
    CAST(organization_id AS STRING) AS company_code,
    CAST(journal_id AS STRING) AS document_number,
    CAST(EXTRACT(YEAR FROM posting_date) AS STRING) AS fiscal_year,
    CAST(line_number AS STRING) AS line_number,
    DATE(posting_date) AS posting_date,
    DATE(document_date) AS document_date,
    CAST(created_at AS TIMESTAMP) AS entry_timestamp,
    CAST(journal_type AS STRING) AS document_type,
    CAST(status AS STRING) AS document_status,
    CAST(reference AS STRING) AS reference_document_number,
    CAST(account_code AS STRING) AS account_code,
    CASE WHEN CAST(amount_tc AS NUMERIC) >= 0 THEN 'S' ELSE 'H' END AS debit_credit_indicator,
    CAST(cost_center AS STRING) AS cost_center,
    CAST(profit_center AS STRING) AS profit_center,
    CAST(plant_code AS STRING) AS plant_code,
    CAST(amount_tc AS NUMERIC) AS amount_tc,
    TRIM(currency_tc) AS currency_tc,
    CAST(amount_fc AS NUMERIC) AS amount_fc,
    TRIM(currency_fc) AS currency_fc,
    CAST(amount_pc AS NUMERIC) AS amount_pc,
    TRIM(currency_pc) AS currency_pc,
    CAST(updated_at AS TIMESTAMP) AS source_last_updated_at
  FROM ${ref("erp_staging", "stg_gl_journal_cdc")}
),

combined AS (
  SELECT * FROM ecc_gl
  UNION ALL
  SELECT * FROM s4_gl
  UNION ALL
  SELECT * FROM new_erp_gl
)

SELECT
  TO_HEX(MD5(CONCAT(source_system, '|', mandt, '|', company_code, '|', document_number, '|', fiscal_year))) AS gl_journal_id,
  source_system,
  mandt,
  company_code,
  document_number,
  fiscal_year,
  line_number,
  posting_date,
  document_date,
  entry_timestamp,
  document_type,
  document_status,
  reference_document_number,
  account_code,
  debit_credit_indicator,
  cost_center,
  profit_center,
  plant_code,
  amount_tc,
  currency_tc,
  amount_fc,
  currency_fc,
  amount_pc,
  currency_pc,
  source_last_updated_at
FROM combined
