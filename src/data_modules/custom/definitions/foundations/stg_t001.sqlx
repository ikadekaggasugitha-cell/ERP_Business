config {
  type: "view",
  schema: dataform.projectConfig.vars.target_dataset,
  tags: ["foundation", "sap_ddic", "ecc", "s4"],
  description: "SAP Company Codes staging view with CDC deduplication"
}

SELECT
  MANDT AS mandt,
  BUKRS AS company_code,
  BUTXT AS company_name,
  ORT01 AS city,
  LAND1 AS country_code,
  WAERS AS currency_key,
  SPRAS AS language_key,
  KTOPL AS chart_of_accounts,
  PERIV AS fiscal_year_variant,
  recordstamp
FROM ${ref("sap_ddic_replica", "t001")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY MANDT, BUKRS
  ORDER BY recordstamp DESC
) = 1
