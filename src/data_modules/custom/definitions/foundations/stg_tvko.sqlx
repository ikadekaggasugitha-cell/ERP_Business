config {
  type: "view",
  schema: dataform.projectConfig.vars.target_dataset,
  tags: ["foundation", "sap_ddic", "ecc", "s4"],
  description: "SAP Sales Organization to Company Code mapping staging view"
}

SELECT
  MANDT AS mandt,
  VKORG AS sales_org,
  BUKRS AS company_code,
  WAERS AS currency_key,
  recordstamp
FROM ${ref("sap_ddic_replica", "tvko")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY MANDT, VKORG
  ORDER BY recordstamp DESC
) = 1
