config {
  type: "view",
  schema: dataform.projectConfig.vars.target_dataset,
  tags: ["foundation", "sap_ddic", "ecc", "s4"],
  description: "SAP Sales Order Item staging view with CDC deduplication"
}

SELECT
  MANDT AS mandt,
  VBELN AS sales_order_number,
  POSNR AS item_number,
  MATNR AS material_number,
  WERKS AS plant,
  LGORT AS storage_location,
  KWMENG AS order_quantity,
  VRKME AS sales_unit,
  NETPR AS net_price,
  NETWR AS net_value,
  WAERK AS currency_key,
  recordstamp
FROM ${ref("sap_ddic_replica", "vbap")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY MANDT, VBELN, POSNR
  ORDER BY recordstamp DESC
) = 1
