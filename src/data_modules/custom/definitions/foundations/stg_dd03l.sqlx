config {
  type: "view",
  schema: dataform.projectConfig.vars.target_dataset,
  tags: ["foundation", "sap_ddic", "ecc", "s4"],
  description: "SAP DDIC Table Fields staging view with active status filter"
}

SELECT
  TABNAME AS table_name,
  FIELDNAME AS field_name,
  POSITION AS position,
  DATATYPE AS data_type,
  LENG AS length,
  DECIMALS AS decimals,
  DDTEXT AS description,
  recordstamp
FROM ${ref("sap_ddic_replica", "dd03l")}
WHERE AS4LOCAL = 'A'
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY TABNAME, FIELDNAME
  ORDER BY recordstamp DESC
) = 1
